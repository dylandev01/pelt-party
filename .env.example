# Generate secrets with: openssl rand -hex 32
NODE_ENV=development
PORT=3000
PUBLIC_ORIGIN=http://localhost:3000
SESSION_SECRET=REPLACE_WITH_AT_LEAST_32_RANDOM_CHARACTERS
ROOM_IDLE_TTL_MINUTES=60
ROOM_MAX_TTL_HOURS=12
DISCONNECT_GRACE_SECONDS=15
# Replace example STUN hostname with a genuine STUN service (or leave blank).
STUN_URL=
# TURN is essential for reliable cross-network connectivity in production.
TURN_URL=
TURN_TLS_URL=
TURN_SHARED_SECRET=
TURN_TTL_SECONDS=3600
TURN_FORCE_RELAY=false
# TEST ONLY: Set true to allow HTTPS hosting without TURN (not reliable across networks).
ALLOW_STUN_ONLY_TEST_MODE=false
DEFAULT_VIDEO_BITRATE_BPS=10000000
MIN_VIDEO_BITRATE_BPS=2000000
MAX_VIDEO_BITRATE_BPS=12000000
ENABLE_SDP_BITRATE_HINTS=true
ENABLE_OPUS_STEREO_HINTS=true
ENABLE_ADVANCED_CAPTURE_HINTS=true
ENABLE_DEBUG_LOGGING=false

# Docker Compose / Caddy: actual DNS hostname for HTTPS (no scheme)
WATCH_HOSTNAME=watch.example.com

# OPTIONAL short-lived third-party TURN test credentials (not for long-term hosting).
# Never commit real values; these are provided as secrets in Render's environment.
# Expiration is an absolute Unix timestamp in seconds. TURN_STATIC_URLS is comma-separated.
TURN_STATIC_URLS=
TURN_STATIC_USERNAME=
TURN_STATIC_CREDENTIAL=
TURN_STATIC_EXPIRES_AT=
