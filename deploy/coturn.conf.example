# Coturn example. Replace everything in angle brackets; never commit real secrets.
# Expose TURN directly, not behind an ordinary HTTP/HTTPS proxy.
realm=<turn.example.com>
server-name=<turn.example.com>
listening-port=3478
tls-listening-port=5349
fingerprint
use-auth-secret
static-auth-secret=<THE_SAME_RANDOM_SECRET_AS_TURN_SHARED_SECRET>
no-multicast-peers
no-loopback-peers
no-cli
stale-nonce=600
min-port=49160
max-port=49260
# If this VPS is behind NAT, configure external-ip=PUBLIC_IP/PRIVATE_IP.
# external-ip=<PUBLIC_IP>/<PRIVATE_IP>
# For TURNS add a public certificate and key accessible to the Coturn service.
# cert=/etc/letsencrypt/live/turn.example.com/fullchain.pem
# pkey=/etc/letsencrypt/live/turn.example.com/privkey.pem
# Optionally bind to your private/public interface using listening-ip/relay-ip.
