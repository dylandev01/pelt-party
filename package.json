{
  "name": "private-cinema",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private one-host/one-viewer WebRTC cinema",
  "engines": { "node": ">=24" },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/*.test.js",
    "test:browser": "playwright test",
    "check": "npm test && npm run test:browser"
  },
  "dependencies": {
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "express-rate-limit": "^8.0.1",
    "helmet": "^8.1.0",
    "socket.io": "^4.8.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "socket.io-client": "^4.8.1"
  }
}
